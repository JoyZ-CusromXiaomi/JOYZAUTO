<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Gerakan kepala -->
            <TextView
                style="@style/Joy.SectionLabel"
                android:layout_marginTop="8dp"
                android:text="@string/section_eye" />

            <com.google.android.material.card.MaterialCardView style="@style/Joy.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Joy.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/eye_sensitivity" />

                        <TextView
                            android:id="@+id/tvEyeValue"
                            style="@style/Joy.RowTitle"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderEye"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="10"
                        android:stepSize="1"
                        app:labelBehavior="gone" />

                    <TextView
                        style="@style/Joy.RowSubtitle"
                        android:text="@string/eye_sensitivity_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gaya scroll -->
            <TextView
                style="@style/Joy.SectionLabel"
                android:text="@string/section_scroll" />

            <com.google.android.material.card.MaterialCardView style="@style/Joy.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Joy.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/scroll_speed" />

                        <TextView
                            android:id="@+id/tvSpeedValue"
                            style="@style/Joy.RowTitle"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="10"
                        android:stepSize="1"
                        app:labelBehavior="gone" />

                    <TextView
                        style="@style/Joy.RowSubtitle"
                        android:text="@string/scroll_speed_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Joy.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/scroll_smoothness" />

                        <TextView
                            android:id="@+id/tvSmoothValue"
                            style="@style/Joy.RowTitle"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSmooth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="10"
                        app:labelBehavior="gone" />

                    <TextView
                        style="@style/Joy.RowSubtitle"
                        android:text="@string/scroll_smoothness_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Timer -->
            <TextView
                style="@style/Joy.SectionLabel"
                android:text="@string/section_timer" />

            <com.google.android.material.card.MaterialCardView style="@style/Joy.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Joy.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/timer_seconds" />

                        <TextView
                            android:id="@+id/tvTimerValue"
                            style="@style/Joy.RowTitle"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="3"
                        android:valueTo="120"
                        android:stepSize="1"
                        app:labelBehavior="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Joy.RowTitle"
                                android:text="@string/timer_jitter" />

                            <TextView
                                style="@style/Joy.RowSubtitle"
                                android:text="@string/timer_jitter_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swJitter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Perintah suara -->
            <TextView
                style="@style/Joy.SectionLabel"
                android:text="@string/section_voice" />

            <com.google.android.material.card.MaterialCardView style="@style/Joy.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/voice_keywords_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKeywords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="text|textNoSuggestions"
                            android:maxLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Joy.RowSubtitle"
                        android:layout_marginTop="8dp"
                        android:text="@string/voice_keywords_help" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Umum -->
            <TextView
                style="@style/Joy.SectionLabel"
                android:text="@string/section_general" />

            <com.google.android.material.card.MaterialCardView style="@style/Joy.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Joy.RowTitle"
                            android:text="@string/supported_only" />

                        <TextView
                            style="@style/Joy.RowSubtitle"
                            android:text="@string/supported_only_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSupportedOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/btn_test" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
