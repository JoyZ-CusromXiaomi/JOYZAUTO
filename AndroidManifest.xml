<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kamera depan (mode gerakan kepala) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Mikrofon (mode perintah suara) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service untuk sensor kamera/mikrofon di latar belakang (Android 14+ wajib per tipe) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Menampilkan notifikasi foreground service (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoScrollJoy">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Layanan Aksesibilitas: mensimulasikan usapan layar ke atas -->
        <service
            android:name=".AutoScrollAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground service: menjalankan kamera (ML Kit) dan pengenalan suara saat app di latar belakang -->
        <service
            android:name=".SensorForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

    <!-- Android 11+: agar SpeechRecognizer bisa menemukan layanan pengenalan suara perangkat -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

</manifest>
