<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 DayNight: otomatis terang/gelap mengikuti sistem -->
    <style name="Theme.AutoScrollJoy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/joy_primary</item>
        <item name="colorOnPrimary">@color/joy_on_primary</item>
        <item name="colorPrimaryContainer">@color/joy_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/joy_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/joy_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/joy_on_secondary_container</item>
        <item name="android:colorBackground">@color/joy_background</item>
        <item name="colorOnBackground">@color/joy_on_surface</item>
        <item name="colorSurface">@color/joy_surface</item>
        <item name="colorOnSurface">@color/joy_on_surface</item>
        <item name="colorSurfaceVariant">@color/joy_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/joy_on_surface_variant</item>
        <item name="colorOutline">@color/joy_outline</item>
        <item name="colorOutlineVariant">@color/joy_outline_variant</item>
    </style>

    <!-- Teks -->
    <style name="Joy.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Joy.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="Joy.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="Joy.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Joy.RowSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="Joy.Footnote" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Kartu datar (tanpa bayangan, hanya garis tepi) -->
    <style name="Joy.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Penanda status: lingkaran kecil solid -->
    <style name="Joy.Dot">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:background">@drawable/bg_status_dot</item>
    </style>

</resources>
